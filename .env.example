# Application
NODE_ENV=development
PORT=5000

# Database (MONGO_URI is the name used by the app; MONGODB_URI is accepted as an alias)
MONGO_URI=
# MONGODB_URI=

# Authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Frontend
# Comma-separated list of allowed browser origins (CORS) and base URL for email links.
# Example: https://your-frontend.vercel.app
FRONTEND_URL=
# Legacy name used for password reset links (falls back to FRONTEND_URL when empty).
# CLIENT_URL=

# Email (SMTP)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM_NAME=CampusCoin

# Uploads (optional)
# Directory used for temporary CSV uploads. Falls back to ./uploads, then to the OS temp dir.
# UPLOAD_DIR=

# Seed scripts only (npm run seed:admin / npm run seed:students)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=
STUDENT_SEED_PASSWORD=
